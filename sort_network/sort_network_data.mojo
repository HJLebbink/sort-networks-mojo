from sort_network.SwapData import Layer, SwapData, SwapPair

comptime s = SwapPair


# join_swap_data joins two swap data's into one sorting network.
# The number of layers doe not increase, only the number of swaps increases
def join_swap_data[sd1: SwapData, sd2: SwapData]() -> SwapData:
    var result = SwapData(sd1.channels + sd2.channels, sd1.n_layers)
    comptime n_layers = sd1.count_layers()
    for i in range(n_layers):
        result.add_layer_l(Layer.merge(sd1[i], sd2[i], sd1.channels))
    return result^


# chanels 0..7 are already sorted, and 8..15 are also already sorted
def swap_data_already_sorted_4_4() -> SwapData:
    var result = SwapData(8, 3)
    # fmt: off
    result.add_layer(0, [s(0,4),s(1,5),s(2,6),s(3,7)])
    result.add_layer(1, [s(2,4),s(3,5)])
    result.add_layer(2, [s(1,2),s(3,4),s(5,6)])
    # fmt: on
    return result^


# chanels 0..7 are already sorted, and 8..15 are also already sorted
def swap_data_already_sorted_8_8() -> SwapData:
    var result = SwapData(16, 4)
    # fmt: off
    result.add_layer(0, [s(0,8),s(1,9),s(2,10),s(3,11),s(4,12),s(5,13),s(6,14),s(7,15)])
    result.add_layer(1, [s(4,8),s(5,9),s(6,10),s(7,11)])
